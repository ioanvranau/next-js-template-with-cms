# Copy to `.env.local` and fill in. Without these, the contact form
# validates input but does NOT send email (the Server Action returns an
# error you can surface in the UI). The site builds and runs regardless.

# Resend (https://resend.com) — free tier: 3,000/mo, 100/day.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=you@example.com

# Public site URL — used by sitemap.ts / robots.ts and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=https://example.ro
